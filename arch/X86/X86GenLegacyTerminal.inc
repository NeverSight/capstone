X86_DECODE_INLINE int decodeLegacyTerminal(struct InternalInstruction *insn,
				MCInst *mcInst, uint16_t *size, uint64_t decision, bool scan, unsigned *publicID)
{
	uint32_t terminal;
	if ((decision & (X86_TERMINAL_INDEXED | X86_TERMINAL_SPLIT)) && (scan ? readModRMScan(insn) : readModRM(insn)))
		return X86_SCAN_INVALID;
	if (decision & X86_TERMINAL_INDEXED) {
		unsigned int index = decision & X86_DECISION_OFFSET_MASK;
		switch ((decision >> X86_DECISION_TYPE_SHIFT) & X86_DECISION_TYPE_MASK) {
		case MODRM_SPLITREG:
			index += regFromModRM(insn->modRM) + (insn->modRM >= 0xc0 ? 8 : 0);
			break;
		case MODRM_SPLITMISC:
			index += insn->modRM >= 0xc0 ? (insn->modRM & 0x3f) + 8 : regFromModRM(insn->modRM);
			break;
		case MODRM_FULL:
			index += insn->modRM;
			break;
		default:
			return X86_SCAN_INVALID;
		}
		terminal = publicID ? x86LegacyPublicTerminals[index] : x86LegacyTerminals[index];
	} else {
		unsigned int shift = (decision & X86_TERMINAL_SPLIT) && insn->modRM >= 0xc0 ?
			X86_TERMINAL_REGISTER_SHIFT : 0;
		terminal = (decision >> shift) & X86_TERMINAL_MASK;
	}
	unsigned instructionID = terminal & X86_TERMINAL_UID_MASK;
	if (publicID) {
		if (!instructionID)
			return X86_SCAN_INVALID;
		int status = scanLegacyOperands(insn, NULL, size, terminal >> X86_TERMINAL_HANDLER_SHIFT);
		if (status == X86_SCAN_COMPLETE)
			*publicID = instructionID;
		return status;
	}
	insn->instructionID = instructionID;
	insn->spec = specifierForUID(insn->instructionID);
	if (!instructionID)
		return X86_SCAN_INVALID;
	if (scan)
		return scanLegacyOperands(insn, mcInst, size, terminal >> X86_TERMINAL_HANDLER_SHIFT);
	insn->operands = x86OperandSets[(terminal >> X86_TERMINAL_OPERAND_SHIFT) & X86_TERMINAL_OPERAND_MASK];
	return x86LegacyHandlers[terminal >> X86_TERMINAL_HANDLER_SHIFT](insn);
}
