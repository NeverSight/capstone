	if ((!insn->consumedModRM && readModRM(insn)) ||
	    fixupRegisterOperand(insn, TYPE_R16) ||
	    fixupRMOperand(insn, TYPE_R32, ENCODING_RM))
		return -1;
	return needVVVV ? -1 : 0;
default:
	break;
}
