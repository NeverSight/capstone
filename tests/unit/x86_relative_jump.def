#ifdef CS_JUMP_VALUE
CS_JUMP_VALUE(MaxBytes, 15)
CS_JUMP_VALUE(Intel, CS_MODE_64 | CS_MODE_X86_INTEL)
CS_JUMP_VALUE(AMD, CS_MODE_64 | CS_MODE_X86_AMD)
#endif
#ifdef CS_JUMP_WIDE_VALUE
CS_JUMP_WIDE_VALUE(Address, 0x123450000ULL)
#endif
#ifdef CS_JUMP_TEXT
CS_JUMP_TEXT(Failure, "%s syntax=%u: incorrect relative JMP extent or detail\n")
#endif
#ifdef CS_JUMP_CASE
