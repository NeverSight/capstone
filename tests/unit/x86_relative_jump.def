CS_JUMP_CASE(AMD16Zero, AMD, 4, 2, 2, 4, 0x66, 0xe9, 0, 0, 0, 0)
CS_JUMP_CASE(AMD16RexW, AMD, 7, 3, 4, Address + 5, 0x66, 0x48, 0xe9, 0xfe, 0xff,
             0xff, 0xff)
